{
  "note": "WAAPI 动画快照样本（手写的，形状照 KeyframeEffect.getKeyframes() + getTiming() 裁剪）。供 scripts/waapi2doc.mjs 的研发与判据用。",
  "fps": {
    "num": 30,
    "den": 1
  },
  "size": {
    "width": 1920,
    "height": 1080
  },
  "animations": [
    {
      "target": "title",
      "timing": {
        "delay": 0,
        "endDelay": 0,
        "fill": "both",
        "iterations": 1,
        "iterationStart": 0,
        "direction": "normal",
        "duration": 1000,
        "easing": "ease-out"
      },
      "keyframes": [
        {
          "offset": 0,
          "easing": "cubic-bezier(0.2, 0.8, 0.4, 1)",
          "opacity": 0,
          "transform": "translateX(-80px) translateY(12px) scale(0.9)"
        },
        {
          "offset": 1,
          "easing": "linear",
          "opacity": 1,
          "transform": "translateX(0px) translateY(0px) scale(1)"
        }
      ]
    },
    {
      "target": "note",
      "timing": {
        "delay": 300,
        "endDelay": 0,
        "fill": "both",
        "iterations": 1,
        "iterationStart": 0,
        "direction": "normal",
        "duration": 600,
        "easing": "steps(4, jump-both)"
      },
      "keyframes": [
        {
          "offset": 0,
          "easing": "steps(4, jump-both)",
          "opacity": 0.2
        },
        {
          "offset": 1,
          "easing": "linear",
          "opacity": 1
        }
      ]
    },
    {
      "target": "badge",
      "timing": {
        "delay": 0,
        "endDelay": 0,
        "fill": "forwards",
        "iterations": 3,
        "iterationStart": 0,
        "direction": "alternate",
        "duration": 400,
        "easing": "linear"
      },
      "keyframes": [
        {
          "offset": 0,
          "easing": "ease_in",
          "opacity": 0.3,
          "transform": "rotate(0deg)"
        },
        {
          "offset": 1,
          "easing": "linear",
          "opacity": 1,
          "transform": "rotate(15deg)"
        }
      ]
    },
    {
      "target": "sparkle",
      "timing": {
        "delay": 0,
        "endDelay": 0,
        "fill": "both",
        "iterations": 2,
        "iterationStart": 0,
        "direction": "alternate",
        "duration": 300,
        "easing": "linear"
      },
      "keyframes": [
        {
          "offset": 0,
          "easing": "back_out",
          "opacity": 0
        },
        {
          "offset": 1,
          "easing": "linear",
          "opacity": 1
        }
      ]
    },
    {
      "target": "card",
      "style": {
        "filter": "blur(4px) contrast(2) saturate(0.5)",
        "mix-blend-mode": "overlay",
        "border-radius": "12px",
        "clip-path": "circle(40px at 25% 75%)"
      },
      "timing": {
        "delay": 0,
        "endDelay": 0,
        "fill": "both",
        "iterations": 1,
        "iterationStart": 0,
        "direction": "normal",
        "duration": 500,
        "easing": "linear"
      },
      "keyframes": [
        {
          "offset": 0,
          "easing": "linear",
          "opacity": 0
        },
        {
          "offset": 1,
          "easing": "linear",
          "opacity": 1
        }
      ]
    },
    {
      "target": "glow",
      "style": {
        "filter": "brightness(1.5)"
      },
      "timing": {
        "delay": 0,
        "endDelay": 0,
        "fill": "both",
        "iterations": 1,
        "iterationStart": 0,
        "direction": "normal",
        "duration": 300,
        "easing": "linear"
      },
      "keyframes": [
        {
          "offset": 0,
          "easing": "linear",
          "opacity": 1
        },
        {
          "offset": 1,
          "easing": "linear",
          "opacity": 1
        }
      ]
    },
    {
      "target": "band",
      "style": {
        "clip-path": "inset(10px 20px round 4px)"
      },
      "timing": {
        "delay": 0,
        "endDelay": 0,
        "fill": "both",
        "iterations": 1,
        "iterationStart": 0,
        "direction": "normal",
        "duration": 400,
        "easing": "linear"
      },
      "keyframes": [
        {
          "offset": 0,
          "easing": "linear",
          "opacity": 1
        },
        {
          "offset": 1,
          "easing": "linear",
          "opacity": 1
        }
      ]
    },
    {
      "target": "poly",
      "style": {
        "clip-path": "polygon(0 0, 100% 0, 100% 100%)"
      },
      "timing": {
        "delay": 0,
        "endDelay": 0,
        "fill": "both",
        "iterations": 1,
        "iterationStart": 0,
        "direction": "normal",
        "duration": 400,
        "easing": "linear"
      },
      "keyframes": [
        {
          "offset": 0,
          "easing": "linear",
          "opacity": 1
        },
        {
          "offset": 1,
          "easing": "linear",
          "opacity": 1
        }
      ]
    },
    {
      "target": "pulse",
      "timing": {
        "delay": 0,
        "endDelay": 0,
        "fill": "both",
        "iterations": 1,
        "iterationStart": 0,
        "direction": "normal",
        "duration": 400,
        "easing": "linear"
      },
      "keyframes": [
        {
          "offset": 0,
          "easing": "ease_in",
          "filter": "blur(2px)",
          "opacity": 1
        },
        {
          "offset": 1,
          "easing": "linear",
          "filter": "blur(12px)",
          "opacity": 1
        }
      ]
    },
    {
      "target": "wobble",
      "timing": {
        "delay": 0,
        "endDelay": 0,
        "fill": "both",
        "iterations": 1,
        "iterationStart": 0,
        "direction": "normal",
        "duration": 400,
        "easing": "linear"
      },
      "keyframes": [
        {
          "offset": 0,
          "easing": "linear",
          "filter": "blur(2px)",
          "opacity": 1
        },
        {
          "offset": 1,
          "easing": "linear",
          "filter": "blur(2px) contrast(1.5)",
          "opacity": 1
        }
      ]
    },
    {
      "target": "wave",
      "timing": {
        "delay": 0,
        "endDelay": 0,
        "fill": "both",
        "iterations": 2,
        "iterationStart": 0,
        "direction": "alternate",
        "duration": 400,
        "easing": "linear"
      },
      "keyframes": [
        {
          "offset": 0,
          "easing": "linear(0, 0.25 75%, 1)",
          "opacity": 0
        },
        {
          "offset": 1,
          "easing": "linear",
          "opacity": 1
        }
      ]
    },
    {
      "target": "drift",
      "timing": {
        "delay": 0,
        "endDelay": 0,
        "fill": "both",
        "iterations": 2,
        "iterationStart": 1,
        "direction": "alternate",
        "duration": 400,
        "easing": "linear"
      },
      "keyframes": [
        {
          "offset": 0,
          "easing": "linear",
          "opacity": 0
        },
        {
          "offset": 1,
          "easing": "linear",
          "opacity": 1
        }
      ]
    }
  ],
  "background": "#101014"
}
