{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project",
  "description": "工程的根对象。",
  "type": "object",
  "properties": {
    "schema": {
      "description": "契约版本。解析后必须等于 SCHEMA_VERSION，否则拒绝。",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "timebase": {
      "$ref": "#/$defs/TimebaseDto"
    },
    "tracks": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/Track"
      }
    }
  },
  "required": [
    "schema",
    "timebase"
  ],
  "$defs": {
    "Clip": {
      "description": "时间线上的一个片段。",
      "type": "object",
      "properties": {
        "duration": {
          "description": "占多少帧。必须为正。",
          "type": "integer",
          "format": "int64"
        },
        "effects": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Effect"
          }
        },
        "id": {
          "type": "string"
        },
        "keyframes": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Keyframe"
          }
        },
        "opacity": {
          "type": "number",
          "format": "float",
          "default": 1.0
        },
        "source": {
          "description": "素材标识。**不含路径语义**——由宿主解释（浏览器是 URL，服务端是本地文件）。",
          "type": "string"
        },
        "source_in": {
          "description": "在素材里的起始帧号。",
          "type": "integer",
          "format": "int64"
        },
        "track_at": {
          "description": "在时间线上的起始帧号。",
          "type": "integer",
          "format": "int64"
        },
        "transform": {
          "$ref": "#/$defs/Transform",
          "default": {
            "rotation_deg": 0.0,
            "scale": 1.0,
            "x": 0.0,
            "y": 0.0
          }
        },
        "transition_in": {
          "description": "入场转场。挂在**后一个**片段上，占它开头的若干帧。",
          "anyOf": [
            {
              "$ref": "#/$defs/TransitionSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "source",
        "source_in",
        "track_at",
        "duration"
      ]
    },
    "Easing": {
      "description": "缓动曲线。公式**写死在这里**，两端调同一个函数——\n各写一遍迟早在某个控制点上差一个像素，而那种差异最难归因。",
      "type": "string",
      "enum": [
        "linear",
        "ease_in",
        "ease_out",
        "ease_in_out"
      ]
    },
    "Effect": {
      "description": "特效：类型 + 参数。**不接受可上传的 shader**——那等于把两端一致性交给用户。",
      "type": "object",
      "properties": {
        "kind": {
          "description": "类型串，对应 core 的特效注册表。",
          "type": "string"
        },
        "params": {
          "description": "参数用 BTreeMap：同一份工程序列化出来必须**逐字节相同**，HashMap 做不到这点。",
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "format": "float"
          },
          "default": {}
        }
      },
      "required": [
        "kind"
      ]
    },
    "Keyframe": {
      "description": "关键帧。frame 是**相对片段起点**的偏移，不是绝对帧号——\n这样片段一挪，关键帧跟着走，不会静默错位。",
      "type": "object",
      "properties": {
        "easing": {
          "$ref": "#/$defs/Easing",
          "default": "linear"
        },
        "frame": {
          "type": "integer",
          "format": "int64"
        },
        "value": {
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "frame",
        "value"
      ]
    },
    "TimebaseDto": {
      "description": "Timebase 的传输形态。用 num/den 而不是浮点 29.97。",
      "type": "object",
      "properties": {
        "den": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "num": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "num",
        "den"
      ]
    },
    "Track": {
      "type": "object",
      "properties": {
        "clips": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Clip"
          }
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/TrackKind"
        }
      },
      "required": [
        "id",
        "kind"
      ]
    },
    "TrackKind": {
      "type": "string",
      "enum": [
        "video",
        "audio"
      ]
    },
    "Transform": {
      "type": "object",
      "properties": {
        "rotation_deg": {
          "description": "角度制。整数帧号之外的东西可以是浮点——**只有时间必须是整数**。",
          "type": "number",
          "format": "float"
        },
        "scale": {
          "type": "number",
          "format": "float"
        },
        "x": {
          "type": "number",
          "format": "float"
        },
        "y": {
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "x",
        "y",
        "scale",
        "rotation_deg"
      ]
    },
    "TransitionKind": {
      "type": "string",
      "enum": [
        "cross_dissolve"
      ]
    },
    "TransitionSpec": {
      "description": "转场：把前一个相邻片段淡出的同时把自己淡入。\n\n用「挂在片段上」而不是「在轨道上单列一条」，是为了让**重叠规则保持简单**：\n轨道内片段仍然不许重叠——转场不破坏这条不变量，也就不需要为它开特例。",
      "type": "object",
      "properties": {
        "duration": {
          "description": "占多少帧。必须为正，且不超过本片段的时长。",
          "type": "integer",
          "format": "int64"
        },
        "kind": {
          "$ref": "#/$defs/TransitionKind"
        }
      },
      "required": [
        "kind",
        "duration"
      ]
    }
  }
}
